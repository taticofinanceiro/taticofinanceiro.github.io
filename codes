<!-- Scripts da Página -->
<script>
// Inicializar Gráfico Dinâmico
const ctx = document.getElementById('fireChart').getContext('2d');
let fireChart = new Chart(ctx, {
type: 'line',
data: {
labels: ['Ano 1', 'Ano 3', 'Ano 5', 'Ano 8', 'Ano 10', 'Ano 15'],
datasets: [{
label: 'Património Acumulado (€)',
data: [6000, 21000, 42000, 85000, 130000, 280000],
borderColor: '#10b981',
backgroundColor: 'rgba(16, 185, 129, 0.1)',
fill: true,
tension: 0.4,
borderWidth: 3
}]
},
options: {
responsive: true,
plugins: { legend: { display: false } },
scales: {
x: { grid: { color: '#1e293b' }, ticks: { color: '#64748b' } },
y: { grid: { color: '#1e293b' }, ticks: { color: '#64748b' } }
}
}
});

// Lógica da Calculadora FIRE & Atualização Dinâmica do Gráfico
function calcularFIRE() {
const despesas = parseFloat(document.getElementById('despesasMensais').value) || 0;
const investimento = parseFloat(document.getElementById('investimentoMensal').value) || 0;

const fireGoal = despesas * 12 * 25;
document.getElementById('fireNumber').innerText = fireGoal.toLocaleString('pt-PT') + ' €';

let anosTotal = 22;
if(investimento > 0) {
let montante = 0;
let meses = 0;
const taxaMensal = 0.07 / 12;
let dadosGrafico = [];
let anosLabels = [];

while (montante < fireGoal && meses < 600) {
montante = (montante + investimento) * (1 + taxaMensal);
meses++;
if (meses % 12 === 0) {
let anoAtual = meses / 12;
if (anoAtual <= 25 && (anoAtual <= 5 || anoAtual % 2 === 0)) {
anosLabels.push(`Ano ${anoAtual}`);
dadosGrafico.push(Math.round(montante));
}
}
}

anosTotal = Math.round(meses / 12);
document.getElementById('fireYears').innerText = `~ ${anosTotal} anos`;

// Atualizar dados do gráfico dinamicamente
if(dadosGrafico.length > 0) {
fireChart.data.labels = anosLabels;
fireChart.data.datasets[0].data = dadosGrafico;
fireChart.update();
}
} else {
document.getElementById('fireYears').innerText = 'N/D';
}
mostrarToast("Calculadora tática atualizada com sucesso!");
}

// Sistema de Toast / Notificações
function mostrarToast(mensagem) {
const toast = document.getElementById('toastNotification');
toast.innerText = mensagem;
toast.classList.remove('translate-y-20', 'opacity-0');
setTimeout(() => {
toast.classList.add('translate-y-20', 'opacity-0');
}, 3000);
}

// Carregar e Guardar Estado do Checklist (localStorage)
document.addEventListener('DOMContentLoaded', () => {
const checkboxes = document.querySelectorAll('.checklist-item');
checkboxes.forEach((cb, index) => {
const salvo = localStorage.getItem(`checklist_${index}`);
if (salvo === 'true') cb.checked = true;

cb.addEventListener('change', (e) => {
localStorage.setItem(`checklist_${index}`, e.target.checked);
mostrarToast("Plano de treino atualizado!");
});
});

// Carregar comentários guardados
carregarComentariosLocalStorage();
});

// Adicionar Comentário com Persistência
function adicionarComentario(event) {
event.preventDefault();
const autor = document.getElementById('autor').value;
const texto = document.getElementById('comentarioTexto').value;

const novoComentarioObj = { autor, texto, data: 'Agora mesmo' };

// Salvar no localStorage
let comentariosSalvos = JSON.parse(localStorage.getItem('comentarios_tatico') || '[]');
comentariosSalvos.unshift(novoComentarioObj);
localStorage.setItem('comentarios_tatico', JSON.stringify(comentariosSalvos));

renderizarComentarioHTML(autor, texto, 'Agora mesmo');
document.getElementById('autor').value = '';
document.getElementById('comentarioTexto').value = '';
mostrarToast("Comentário publicado no balneário!");
}

function renderizarComentarioHTML(autor, texto, data) {
const novoComentario = document.createElement('div');
novoComentario.className = "bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2";
novoComentario.innerHTML = `
<div class="flex justify-between items-center">
<span class="font-bold text-sm text-emerald-400">${autor}</span>
<span class="text-xs text-slate-500">${data}</span>
</div>
<p class="text-sm text-slate-300">${texto}</p>
`;
document.getElementById('listaComentarios').prepend(novoComentario);
}

function carregarComentariosLocalStorage() {
let comentariosSalvos = JSON.parse(localStorage.getItem('comentarios_tatico') || '[]');
comentariosSalvos.forEach(c => {
renderizarComentarioHTML(c.autor, c.texto, c.data);
});
}

// Subscrever Newsletter
function subscreverNewsletter(event) {
event.preventDefault();
document.getElementById('emailNewsletter').value = '';
mostrarToast("Inscrição efetuada com sucesso!");
}
</script>
